# CHAI environment variables — NAMES ONLY.
# Never put real values in this file. Real values live in Vercel →
# Project → Settings → Environment Variables (and in a local, untracked .env).

# ── Required: AI (Google Gemini, free tier) ──────────────────────────────────
GOOGLE_AI_KEY=
# Optional: override the Gemini model name used by all AI endpoints
GEMINI_MODEL=

# ── Required: Google Sheets (duty data, exchange rates, scanner state) ───────
# Spreadsheet ID (the long string between /d/ and /edit in the sheet URL)
GSHEET_ID=
# Full service-account JSON pasted as one line
GSERVICE_ACCOUNT=
# Published-CSV URL of the Duty tab, read by api/duty.js
GSHEET_DUTY_URL=

# ── Required: scanner protection ─────────────────────────────────────────────
# If BOTH are empty, /api/scan-cbic and /api/scan-dgft run for anyone.
# Vercel cron sends "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Manual trigger: /api/scan-cbic?secret=<SCAN_SECRET>
SCAN_SECRET=

# ── Required: frontend (Vite exposes VITE_* to the browser — public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Razorpay Key ID (the public "rzp_..." id, NOT the key secret)
VITE_RAZORPAY_KEY_ID=

# ── Optional: live integrations (code falls back to curated data if unset) ───
# api/iec.js
DGFT_API_URL=
DGFT_API_KEY=
# api/exchange.js
EXCHANGE_API_URL=
# api/icegateStatus.js
ICEGATE_STATUS_URL=
